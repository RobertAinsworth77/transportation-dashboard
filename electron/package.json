  "description": "itel's Transportation Admin Module",
  "icon": "logo.ico",
  "main": "electron-starter.js",
  "author": "Marlon Mendez",
  "license": "MIT",
  "private": true,
  "homepage": "/",
  "devDependencies": {
    "electron": "^24.8.8",
    "electron-builder": "^24.6.4"
  },
  "scripts": {
    "start": "set ELECTRON_IS_DEV=0 && electron .",
    "build": "electron-builder",
    "export": "./mac-exporter.sh"
